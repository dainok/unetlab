{
    "archive": {
        "exclude": [
            "README.md",
            "bower.js",
            "package.json",
            ".npmignore",
            "CHANGELOG.md"
        ]
    },
    "description": "Web based JavaScript HTML WYSIWYG editor control.",
    "extra": {
        "component": {
            "files": [
                "tinymce.min.js",
                "plugins/*/plugin.min.js",
                "themes/*/theme.min.js",
                "models/*/model.min.js",
                "skins/**",
                "icons/*/icons.min.js"
            ],
            "scripts": [
                "tinymce.js",
                "plugins/*/plugin.js",
                "themes/*/theme.js",
                "models/*/model.js",
                "icons/*/icons.js"
            ]
        }
    },
    "homepage": "https://www.tiny.cloud/",
    "keywords": [
        "wysiwyg",
        "tinymce",
        "richtext",
        "javascript",
        "html",
        "text",
        "rich editor",
        "rich text editor",
        "rte",
        "rich text",
        "contenteditable",
        "editing"
    ],
    "license": [
        "MIT-only"
    ],
    "name": "tinymce/tinymce",
    "type": "component",
    "version": "6.4.2"
}
